# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EmailJS: Sends the "Book Consultation" form directly from the browser, no backend involved.
# Setup (one-time):
#   1. Create a free account at https://www.emailjs.com
#   2. Email Services -> Add New Service -> connect the Gmail/Outlook account you want to send FROM.
#      Copy the generated Service ID into VITE_EMAILJS_SERVICE_ID below.
#   3. Email Templates -> Create New Template. Set "To Email" to deepakprasath02@gmail.com.
#      Use these variables in the template body: {{from_name}}, {{company}}, {{from_email}},
#      {{phone}}, {{preferred_date}}, {{preferred_time}}, {{topic}}.
#      Copy the generated Template ID into VITE_EMAILJS_TEMPLATE_ID below.
#   4. Account -> General -> copy your Public Key into VITE_EMAILJS_PUBLIC_KEY below.
# These are exposed to the browser bundle (that's normal/required for EmailJS's client-side
# flow) - do not put any other secret values behind the VITE_ prefix.
VITE_EMAILJS_SERVICE_ID="MY_EMAILJS_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="MY_EMAILJS_TEMPLATE_ID"
VITE_EMAILJS_PUBLIC_KEY="MY_EMAILJS_PUBLIC_KEY"
